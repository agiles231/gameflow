{
  "version": 1,
  "description": "GameFlow model routing. Explicit first-available candidate order; highest-priority matching rule wins. No empirical tool proficiency claims.",
  "profiles": {
    "focused": {
      "description": "Small objective work; prefer Luna, then an explicitly approved capable fallback.",
      "candidates": [
        {
          "model": "gpt-6-luna",
          "reasoning_effort": "medium"
        },
        {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "medium"
        },
        {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        }
      ]
    },
    "visual": {
      "description": "Bounded visual/application operations; scripting-heavy work belongs to engineering.",
      "candidates": [
        {
          "model": "gpt-6.1-terra",
          "reasoning_effort": "medium"
        },
        {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "medium"
        },
        {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        }
      ]
    },
    "engineering": {
      "description": "Ordinary coding, automation and integration across understood interfaces.",
      "candidates": [
        {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "medium"
        },
        {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        }
      ]
    },
    "engineering-high": {
      "description": "Substantial but understood reasoning; try Sol at high effort.",
      "candidates": [
        {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "high"
        },
        {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        }
      ]
    },
    "demanding": {
      "description": "Conservative default for demanding spatial, temporal or coupled work.",
      "candidates": [
        {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        }
      ]
    },
    "repair": {
      "description": "Automatic escalation after failed acceptance; no smaller-model fallback.",
      "candidates": [
        {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        }
      ]
    }
  },
  "default_profile": "engineering",
  "repair_profile": "repair",
  "rules": [
    {
      "id": "generation-animation",
      "description": "Creative mesh production and authorized rigging/animation require Astra; polling/delivery are distinct operations.",
      "priority": 900,
      "match": {
        "operations_any": [
          "mesh-generation",
          "mesh-prompt-design",
          "rigging",
          "animation-production",
          "animation-evaluation"
        ]
      },
      "profile": "demanding"
    },
    {
      "id": "demanding-complexity",
      "description": "Demanding complexity overrides cheaper routine-work rules.",
      "priority": 800,
      "match": {
        "dimensions_min": {
          "complexity": 3
        }
      },
      "profile": "demanding"
    },
    {
