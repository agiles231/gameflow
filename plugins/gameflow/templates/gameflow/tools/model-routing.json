    {
      "id": "bounded-visual",
      "description": "Clear visual/application work without demanding temporal judgment.",
      "priority": 400,
      "match": {
        "operations_any": [
          "visual-inspection",
          "application-operation",
          "image-edit",
          "material-hookup"
